# Copier ce fichier en `.env.local` (jamais commité) et renseigner les
# valeurs réelles. Aucun secret ne doit jamais être commité dans le repo.

# --- Base de données (Neon Postgres) ---
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Session admin ---
# Générer avec: openssl rand -base64 32
SESSION_SECRET=""

# --- Provisionnement du compte admin (usage ponctuel : `npm run db:seed-admin`) ---
# Pas de formulaire d'inscription : un seul compte photographe, créé/mis à
# jour via ce script. Ne renseigner ces valeurs que le temps de lancer la
# commande, ou les passer en ligne de commande sans les écrire dans un
# fichier.
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""

# --- Stockage objet (compatible S3 — Backblaze B2 par défaut, aucune carte
# bancaire requise ; Cloudflare R2 fonctionne aussi mais demande une carte
# à l'activation, voir PROJECT_CONTEXT.md §7) ---
# Backblaze B2 : créer un compte sur backblaze.com/sign-up/cloud-storage,
# créer un bucket, "Application Keys" → "Add a New Application Key" pour
# obtenir keyID/applicationKey. L'endpoint et la région exacts (ex.
# "s3.us-west-004.backblazeb2.com" / "us-west-004") sont affichés sur la
# page du bucket, juste après sa création.
STORAGE_ENDPOINT="https://s3.<region>.backblazeb2.com"
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET_ORIGINALS=""
STORAGE_BUCKET_PREVIEWS=""

# --- Paiement (non branché en V1 — placeholders pour plus tard) ---
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# --- Email transactionnel (4 emails, voir src/lib/email/README.md :
# galerie disponible, sélection reçue, paiement reçu, photos prêtes) ---
# Compte gratuit sur resend.com (100 emails/jour, aucune carte bancaire) —
# créer une clé API et la coller ici. Sans cette variable, l'envoi
# d'email est simplement ignoré (log d'avertissement, pas d'erreur) — le
# reste de l'app fonctionne normalement.
RESEND_API_KEY=""
# Adresse d'expédition — resend.dev fonctionne sans configuration mais
# n'est destiné qu'aux tests (délivrabilité limitée). Pour de vrais envois
# clients, vérifier un domaine sur resend.com et utiliser une adresse de
# ce domaine ici.
RESEND_FROM_EMAIL="Inkz <onboarding@resend.dev>"
# URL publique du site — utilisée pour construire les liens cliquables
# dans les emails (sans elle, ils pointent vers localhost). Sur Vercel :
# l'URL de production (ex. "https://inkz-galeries-snowy.vercel.app").
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
