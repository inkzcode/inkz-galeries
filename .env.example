# Copier ce fichier en `.env.local` (jamais commité) et renseigner les
# valeurs réelles. Aucun secret ne doit jamais être commité dans le repo.

# --- Base de données (Neon Postgres) ---
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Session admin ---
# Générer avec: openssl rand -base64 32
SESSION_SECRET=""

# --- Stockage objet (Cloudflare R2, compatible S3) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_ORIGINALS=""
R2_BUCKET_PREVIEWS=""

# --- Paiement (non branché en V1 — placeholders pour plus tard) ---
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# --- Email transactionnel (non branché en V1 — placeholder pour plus tard) ---
# RESEND_API_KEY=""
